{
  "name": "cms-cinema-customer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests scripts vite.config.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:http": "playwright test -c playwright.http.config.js",
    "check:language": "node scripts/check-language.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.js *.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "lucide-react": "^1.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.9.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.3.1",
    "prettier": "^3.6.2"
  }
}
